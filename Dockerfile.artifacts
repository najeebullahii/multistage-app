FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN mkdir -p dist && echo "Build output" > dist/bundle.js

FROM scratch AS artifacts
COPY --from=build /app/dist /dist

FROM node:20-alpine AS production
WORKDIR /app
COPY --from=artifacts /dist ./dist
COPY package*.json server.js ./
CMD ["node", "server.js"]
